# =============================================================================
# SHOPASSIST — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains live API keys.
# =============================================================================



# ── Supabase (Required) ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── AWS Bedrock (Required — active LLM provider) ─────────────────────────────
AWS_BEARER_TOKEN_BEDROCK=absk...

# ── Google AI (Required by startup validation, even though Bedrock is active) ─
GOOGLE_API_KEY=AIza...

# ── Groq (Optional — unused fallback) ─────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── LangSmith Tracing (Optional) ──────────────────────────────────────────────
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT="AI_Shopping_Assistant"
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Support Contact (Optional — has defaults) ─────────────────────────────────
SUPPORT_EMAIL=support@your-store.com
SUPPORT_PHONE=+1-800-555-0199

# ── CORS (Optional — default allows localhost:5173) ───────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
